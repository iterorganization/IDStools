#!/usr/bin/env python3
"""
Create a summary IDS from the other IDSs stored in an IMAS data entry and write it
back into the same entry. If the entry already holds a summary IDS, the command
stops with an error, unless --force is given.

Every filled summary quantity records in its source node the IDS path it was taken
or computed from. Data Dictionary 3 and 4 entries are supported; the summary is
written in the DD version of the entry, without conversion.

Example:
    create_summary -u "imas:hdf5?path=/path/to/entry" --dry-run
    create_summary -u "imas:hdf5?path=/path/to/entry" --force
"""

import argparse
import logging
import sys

from rich_argparse import RawDescriptionRichHelpFormatter

from idstools.domain.summary import (
    TIME_BASE_CANDIDATES,
    SummaryError,
    build_summary,
    check_writable,
    write_summary,
)
from idstools.utils.clihelper import uri_parser
from idstools.utils.idslogger import setup_logger

if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=RawDescriptionRichHelpFormatter,
        parents=[uri_parser],
    )
    parser.add_argument("--force", action="store_true", help="overwrite the summary IDS if it already exists")
    parser.add_argument("--dry-run", action="store_true", help="build and print the summary, but do not write it")
    parser.add_argument(
        "--time-base",
        metavar="IDS",
        help="IDS defining the summary time base (default: first of "
        + ", ".join(dict.fromkeys(name for name, _ in TIME_BASE_CANDIDATES))
        + ")",
    )
    parser.add_argument("--comment", help="summary ids_properties/comment")
    parser.add_argument(
        "-v",
        "--verbose",
        action="count",
        default=0,
        help="-v: print the summary and info messages, -vv: also debug messages",
    )
    args = parser.parse_args()

    logger = setup_logger("module", stdout_level=[logging.WARNING, logging.INFO, logging.DEBUG][min(args.verbose, 2)])
    logging.getLogger("imas").setLevel(logging.WARNING)
    try:
        if not args.dry_run:
            check_writable(args.uri, args.force)  # fail before building the summary
        summary = build_summary(
            args.uri,
            time_base=args.time_base,
            comment=args.comment,
            verbose=args.dry_run or args.verbose > 0,
        )
        if args.dry_run:
            print("Dry run: summary not written.")
        else:
            write_summary(summary, args.uri, force=args.force)
            print(f"Summary written to {args.uri}")
    except SummaryError as exc:
        logger.error(str(exc))
        sys.exit(1)
